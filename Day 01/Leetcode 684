Q.684  -->  Redundant Connection
// Solution by DSU optimised

class Solution {           //By DSU
    static int[] parent;
    static int[] size;
    public int find(int a){
        if(parent[a]==a) return a;
        return parent[a]=find(parent[a]);
    }
    public void union(int a,int b){
        a=find(a);
        b=find(b);
        if(a!=b){
            if(size[a]>size[b]){
                parent[b]=a;
                size[a]+=size[b];
            }
            else{
                parent[a]=b;
                size[b]+=size[a];
            }
        }
    }
    public int[] findRedundantConnection(int[][] edges) {
        int n=edges.length;
        parent=new int[n+1];
        size=new int[n+1];
        for(int i=1;i<=n;i++){
            parent[i]=i;
            size[i]=i;
        }
        int[] ans=new int[2];
        for(int[] arr:edges){
            int a=arr[0], b=arr[1];
            if(find(a)==find(b)){
                ans[0]=a; ans[1]=b;
            }
            else{
                union(a,b);
            }
        }        
        return ans;
    }
}
