Maxium Product Subarray

// Prefix aage se chlaege or suffix piche se maultiply krte chlenge or jha bhi 0 aaye vha se vapis 1 se start kr denge or sath sath dono ko max se compare krte chlenge taki max return  kra ske.

class Solution {
    public int maxProduct(int[] nums) {
        int n=nums.length;
        int suff=1, pre=1;
        int ans=Integer.MIN_VALUE;
        for(int i=0;i<n;i++){
            if(pre==0) pre=1;
            if(suff==0) suff=1;
            pre=pre*nums[i];
            suff=suff*nums[n-i-1];
            ans=Math.max(ans,Math.max(pre,suff));
        }   
        return ans;     
    }
}
