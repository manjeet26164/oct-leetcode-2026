Longest consecutive sequence

class Solution {
    public int longestConsecutive(int[] nums) {
        int n = nums.length;
        HashSet<Integer> set = new HashSet<>();
        for (int i = 0; i < n; i++) {
            set.add(nums[i]);
        }
        int max = 0;
        for (int ele : set) {
            if (!set.contains(ele - 1)) {       // Agar piche koi ele nhi h uske to ussi no. ke starting smjh ke curr kr ke 
                int count = 1;                  // aage badenge.
                int curr = ele;

                while (set.contains(curr + 1)) {
                    count++;
                    curr++;
                }
                max = Math.max(max, count);
            }
        }
        return max;
    }
}
