Koko eating banana.


class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int low=1;
        int high=0;
        for(int pile:piles){
            high=Math.max(high,pile);
        }
        while(low<high){
            int mid=low+(high-low)/2;
            int k=0;
            for(int ele:piles){
                k+=(ele+mid-1)/mid;     // ceil division approach
            }
            if(k>h){
                low=mid+1;
            }
            else{
                high=mid;
            }
        }
        return low;
    }
}
