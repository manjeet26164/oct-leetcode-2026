Find the smallest divisor given a threashold



class Solution {
    public int smallestDivisor(int[] nums, int threshold) {
        int low=1;
        int high=0;
        for(int ele:nums){
            high=Math.max(high,ele);
        }
        while(low<high){
            int mid=low+(high-low)/2;
            int sum=0;
            for(int num:nums){
                sum+=(num+mid-1)/mid;       // Formula for ceil division => quoteint=(num + divisio-1)/divisor
            }
            if(sum<=threshold){
                high=mid;
            }
            else low=mid+1;
        }
        return low;
    }
}
