Sort colors

// i=0, j=1, k=2 maan lena h kyuki yhi 3 colors h hmare pass, fir hme yee pta h 2 last me aaegea to k ke last me rakh diya ab agar kisi ke pass uski value nhi h to usse swap kr denge.


class Solution {
    public void sortColors(int[] nums) {
        int n=nums.length;
        int i=0, j=0, k=n-1;
        while(j<=k){
            if(nums[j]==2){
                int temp=nums[j];
                nums[j]=nums[k];
                nums[k]=temp;
                k--;
            }
            else if(nums[j]==0){
                int temp=nums[i];
                nums[i]=nums[j];
                nums[j]=temp;
                i++;
                j++;
            }
            else if(nums[j]==1){
                j++;
            }
        }
    }
}
