find all numbers diappeared in an array

class Solution {
    public List<Integer> findDisappearedNumbers(int[] nums) {
        int n=nums.length, i=0;
        List<Integer> ans=new ArrayList<>();
        while(i<n){
            int idx=nums[i]-1;
            if(nums[i]<=n && nums[i]!=nums[idx]){
                int temp=nums[i];
                nums[i]=nums[idx];
                nums[idx]=temp;
            }
            else i++;
        }
        for(int j=0;j<n;j++){
            if(nums[j]!=j+1){
                ans.add(j+1);
            }
        }
        return ans;
    }
}
