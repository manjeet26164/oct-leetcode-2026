Palindrome Linked List 

class Solution {
    public ListNode reverse(ListNode head){
        ListNode prev=null;
        ListNode curr=head;
        while(curr!=null){
            ListNode next=curr.next;
            curr.next=prev;
            prev=curr;
            curr=next;
        }
        return prev;

    }
    public boolean isPalindrome(ListNode head) {
        if(head==null || head.next==null) return true;
        ListNode slow=head;
        ListNode fast=head;
        while(fast.next!=null && fast.next.next!=null){
            slow=slow.next;
            fast=fast.next.next;
        }
        ListNode dummyHead=slow.next;
        slow.next=null;
        ListNode rev=reverse(dummyHead);
        ListNode first=head;
        while(rev!=null){ 
            if(first.val!=rev.val){
                return false;
            }
            first=first.next;
            rev=rev.next;
        }
        return true;
    }
}
